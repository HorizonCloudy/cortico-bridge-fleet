    "./segment": "./dist/src/segment.js",
    "./envelope": "./dist/src/envelope.js",
    "./dedup": "./dist/src/dedup.js",
    "./driver": "./dist/src/driver.js",
    "./negotiate": "./dist/src/negotiate.js",
    "./errors": "./dist/src/errors.js",
    "./correlate": "./dist/src/correlate.js",
