{
  "name": "cortico-world-onebot-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico 侧 OneBot v11 world 包骨架：正向 WebSocket 接入任意 v11 实现，一个通用 action dispatcher 覆盖 35 动作（reality 38 减 3 凭证动作）与 17 事件叶子；不承诺 v12。",
  "license": "MIT",
  "author": { "name": "Coopanion bridge fleet" },
  "keywords": ["cortico-world", "cortico", "onebot", "onebot-v11", "qq", "napcat", "snowluma", "llonebot"],
  "engines": { "node": ">=22.16.0" },
  "main": "./src/definition.js",
  "exports": { ".": "./src/definition.js" },
  "files": [
    "src",
    "describe.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "describe": "node tools/selfcheck.mjs --write",
    "selfcheck": "node tools/selfcheck.mjs",
    "check": "node tools/selfcheck.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "OneBot Bridge",
    "tags": ["qq", "onebot", "onebot-v11"],
    "describe": "describe.json"
  }
